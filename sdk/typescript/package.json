{
  "name": "@anona-labs/compute-sdk",
  "version": "0.0.0",
  "description": "Anona Compute extras on top of the E2B SDK",
  "license": "Apache-2.0",
  "homepage": "https://compute.anonalabs.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonalabs/anona-compute-sdk.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:it": "vitest run --config vitest.it.config.ts",
    "version:tag": "node scripts/version-from-tag.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@e2b/desktop": "^2.5.0",
    "e2b": "^2.61.0"
  },
  "peerDependenciesMeta": {
    "@e2b/desktop": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "e2b": "2.61.0",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
